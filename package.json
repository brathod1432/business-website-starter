{
  "name": "business-website-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade, reusable business website starter built with Next.js, TypeScript, Tailwind CSS, and ShadCN-style UI.",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.0.0",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "jest-axe": "9.0.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
