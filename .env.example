# ---------------------------------------------------------------------------
# Business Website Starter — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, canonical + OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (leave blank to disable). e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (leave blank to disable). e.g. abcdefghij
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Contact form submission endpoint (server route by default).
# Swap for a real provider (Resend, SendGrid, Formspree, etc.) later.
CONTACT_FORM_ENDPOINT=/api/contact
