# ---------------------------------------------------------------------------
# Business Website Starter — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, canonical + OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (leave blank to disable). e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (leave blank to disable). e.g. abcdefghij
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Email delivery (contact + newsletter) --------------------------------
# If RESEND_API_KEY + EMAIL_FROM are set, forms send real email via Resend.
# Otherwise submissions are validated and "simulated" (logged), so the starter
# works with zero configuration. These are SERVER secrets — never NEXT_PUBLIC.
RESEND_API_KEY=
EMAIL_FROM=
# Where contact/newsletter notifications are delivered (falls back to EMAIL_FROM).
CONTACT_TO_EMAIL=

# --- Spam protection: Cloudflare Turnstile (optional) ---------------------
# Set BOTH to enable the CAPTCHA. Leave blank to disable (honeypot still runs).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
